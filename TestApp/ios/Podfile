# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

install! 'cocoapods', :share_schemes_for_development_pods => true

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TestApp' do
  config = use_native_modules!

  # CocoaPods trunk stops accepting new versions on 2 Dec 2026. Uncomment to resolve KlarnaMobileSDK
  # from the podspec on our CDN instead of trunk. The packages' podspecs still choose the subspecs.
  # The version is bumped by scripts/update-sdk-versions.sh.
  # pod 'KlarnaMobileSDK/core', :podspec => 'https://x.klarnacdn.net/mobile-sdk/ios/specs/KlarnaMobileSDK/2.16.1/KlarnaMobileSDK.podspec'

  pod 'react-native-klarna-inapp-sdk',
    :path => '../../node_modules/react-native-klarna-inapp-sdk',
    :testspecs => ['Tests']

  pod 'react-native-klarna-network-core',
    :path => '../../node_modules/@klarna/react-native-klarna-network-core',
    :testspecs => ['Tests']

  pod 'react-native-klarna-network-payment',
    :path => '../../node_modules/@klarna/react-native-klarna-network-payment',
    :testspecs => ['Tests']

  pod 'react-native-klarna-network-messaging',
    :path => '../../node_modules/@klarna/react-native-klarna-network-messaging',
    :testspecs => ['Tests']

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react_native_post_install raises each pod's deployment target but skips the test
    # targets, which keep their podspec's minimum. Fabric's C++ headers don't compile
    # for react-native-klarna-inapp-sdk's iOS 10.0, so its tests need this too.
    installer.target_installation_results.pod_target_installation_results.each do |_, result|
      result.test_native_targets.each do |target|
        target.build_configurations.each do |config|
          current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || min_ios_version_supported
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = [min_ios_version_supported.to_f, current.to_f].max.to_s
        end
      end
    end
  end
end
